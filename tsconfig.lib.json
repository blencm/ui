{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*",
    "src/shared/**/*",
    "src/hooks/**/*",
    "src/utils/**/*",
    "src/types/**/*"
  ]
}
