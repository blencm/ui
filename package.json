{
  "name": "@blencm/ui",
  "version": "0.0.1",
  "private": false,
  "author": "Bleker <bleker@blencm.com>",
  "description": "Installable React UI library built on Radix UI and Tailwind CSS. Accessible primitives, form helpers (React Hook Form + Zod), DataTable, SearchableSelect, date/time pickers, dialogs and toasts. Import from npm — no copy-paste into src/components.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "blencm-ui": "./bin/blencm-ui.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/style.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "keywords": [
    "blencm-ui",
    "react",
    "react-ui",
    "react-component-library",
    "ui-library",
    "design-system",
    "radix",
    "radix-ui",
    "radix-primitives",
    "tailwind",
    "tailwindcss",
    "tailwind-css",
    "accessible",
    "a11y",
    "aria",
    "wai-aria",
    "typescript",
    "components",
    "button",
    "dialog",
    "modal",
    "dropdown",
    "select",
    "combobox",
    "searchable-select",
    "forms",
    "form-components",
    "react-hook-form",
    "zod",
    "input",
    "datepicker",
    "date-picker",
    "time-picker",
    "data-table",
    "tanstack-table",
    "pagination",
    "toast",
    "sonner",
    "dark-mode",
    "vite",
    "nextjs",
    "npm-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blencm/blencm-ui.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blencm/blencm-ui/issues"
  },
  "homepage": "https://ui.blencm.com",
  "scripts": {
    "dev": "vite",
    "build": "rimraf ./dist && tsup && tsc -p tsconfig.lib.json && node scripts/postbuild.js",
    "test": "cross-env NODE_ENV=test && jest",
    "test:watch": "jest --watch",
    "clean": "rimraf ./dist",
    "build:vite": "vite build",
    "build:demo": "vite build && node scripts/copy-demo-404.js",
    "preview:demo": "vite preview",
    "prepack": "pnpm run build"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/config-array": "^0.23.5",
    "@eslint/object-schema": "^3.0.5",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "babel-jest": "^30.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-test-renderer": "^19.2.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vaul": "^1.1.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-ts-alias": "^0.1.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=17.0.0 <21.0.0",
    "react-dom": ">=17.0.0 <21.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "^9.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "react-dropzone": "^20.1.0",
    "react-helmet-next": "^0.0.2",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  }
}
